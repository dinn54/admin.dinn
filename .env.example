# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# NextAuth.js
AUTH_SECRET=your_auth_secret_here # Run: openssl rand -base64 32

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Admin Email (only this email can login, leave empty to allow all)
ADMIN_EMAIL=your_admin_email@gmail.com

# Google Indexing API (Service Account)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your_service_account@project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Webhook Secret (Supabase → /api/webhooks/indexing)
WEBHOOK_SECRET=your_webhook_secret

# Site domain (e.g. https://dinn.dev)
NEXT_PUBLIC_SERVICE_DINN_DEV_DOMAIN=https://dinn.dev

# Slack Incoming Webhook URL (선택)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
